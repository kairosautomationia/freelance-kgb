---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "KGB Security Services & Solutions",
  description = "Seguridad integral para mercancías y operaciones de importación-exportación.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/cargo-reference.png" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
