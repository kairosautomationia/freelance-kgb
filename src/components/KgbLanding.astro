---
import BaseLayout from "../layouts/BaseLayout.astro";

const navigation = [
  { href: "#services", label: "Servicios" },
  { href: "#operation", label: "Operación" },
  { href: "#coverage", label: "Cobertura" },
];

const services = [
  {
    number: "01",
    name: "Seguridad física",
    detail: "Personal preparado para accesos, instalaciones y puntos críticos.",
    items: ["Control de accesos", "Rondas de vigilancia", "Prevención y respuesta"],
  },
  {
    number: "02",
    name: "Seguridad electrónica",
    detail: "Tecnología para mantener la operación visible y bajo control.",
    items: ["Cámaras y sensores", "Alarmas", "Monitoreo especializado"],
  },
  {
    number: "03",
    name: "Custodias de carga",
    detail: "Acompañamiento coordinado para mercancías en tránsito y almacenamiento.",
    items: ["Importación y exportación", "Custodias armadas", "Custodias fluviales"],
  },
  {
    number: "04",
    name: "Inspecciones especializadas",
    detail: "Verificaciones adicionales para operaciones que requieren mayor control.",
    items: ["Inspecciones K9", "Sustancias fiscalizadas", "Pruebas poligráficas"],
  },
];

const operationSteps = [
  {
    number: "01",
    name: "Entender la carga",
    detail: "Revisamos el tipo de mercancía, sus puntos sensibles y las condiciones de la operación.",
  },
  {
    number: "02",
    name: "Definir el control",
    detail: "Ordenamos personal, tecnología y protocolos alrededor de la ruta que necesita protección.",
  },
  {
    number: "03",
    name: "Acompañar el tránsito",
    detail: "Integramos custodias y monitoreo para que la información llegue cuando hace falta decidir.",
  },
  {
    number: "04",
    name: "Verificar cada etapa",
    detail: "Sumamos inspecciones especializadas cuando la operación necesita una capa adicional.",
  },
];

const serviceOptions = [
  "Seguridad física",
  "Seguridad electrónica",
  "Custodia de mercancía",
  "Inspección especializada",
  "Necesito orientación",
];
---

<BaseLayout
  title="KGB Security Services & Solutions"
  description="Seguridad física, electrónica y custodia para operaciones de importación y exportación."
>
  <div class="site-shell" id="top">
    <div class="utility-bar">
      <p><span class="utility-signal" aria-hidden="true"></span> Seguridad integral para importación y exportación</p>
      <div class="utility-links">
        <span>Cobertura nacional</span>
        <a href="tel:+593985511942">098 551 1942</a>
      </div>
    </div>

    <header class="site-header">
      <a class="brand-lockup" href="#top" aria-label="KGB Security Services & Solutions, inicio">
        <img src="/assets/kgb-logo-official.png" alt="KGB Security Services & Solutions" width="340" height="110" />
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">
        <span>Menú</span>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      </button>

      <nav class="main-navigation" id="main-navigation" aria-label="Navegación principal">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="header-action" href="#contact">Solicitar evaluación <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow"><span class="signal-dot" aria-hidden="true"></span> Seguridad para operaciones en movimiento</p>
          <h1 id="hero-title">Protegemos la carga en cada decisión.</h1>
          <p class="hero-intro">
            Integramos personas, monitoreo y custodia para que tu operación de importación o exportación avance con un control claro.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#contact">Solicitar una evaluación <span aria-hidden="true">↗</span></a>
            <a class="quiet-link" href="#operation">Ver cómo trabajamos <span aria-hidden="true">↓</span></a>
          </div>

          <div class="hero-board" aria-label="Capas de protección">
            <div class="board-heading">
              <span>Capas de protección</span>
              <span class="board-status"><i aria-hidden="true"></i> Coordinadas</span>
            </div>
            <div class="board-row"><span>01</span><strong>Presencia</strong><span>Personal y accesos</span></div>
            <div class="board-row"><span>02</span><strong>Visibilidad</strong><span>Cámaras y monitoreo</span></div>
            <div class="board-row"><span>03</span><strong>Tránsito</strong><span>Custodias y rutas</span></div>
          </div>
        </div>

        <div class="hero-media" data-reveal style="--reveal-delay: 90ms">
          <figure class="hero-figure">
            <img src="/assets/cargo-reference.png" alt="Contenedores y vehículo de seguridad en una operación portuaria" width="525" height="655" />
            <figcaption>
              <span>Cadena logística</span>
              <strong>Origen <i aria-hidden="true">→</i> tránsito <i aria-hidden="true">→</i> destino</strong>
            </figcaption>
          </figure>
          <div class="hero-media-note">
            <span class="note-index">KGB / 01</span>
            <p>Una misma lectura de seguridad para toda la ruta.</p>
          </div>
        </div>
      </section>

      <section class="proof-strip" aria-label="Alcances de KGB">
        <div><span>01</span><strong>Seguridad física</strong><small>Personas y accesos</small></div>
        <div><span>02</span><strong>Seguridad electrónica</strong><small>Visibilidad y monitoreo</small></div>
        <div><span>03</span><strong>Custodias de carga</strong><small>Tránsito y almacenamiento</small></div>
        <div><span>04</span><strong>Inspecciones K9</strong><small>Verificación especializada</small></div>
      </section>

      <section class="section-block services-section" id="services" aria-labelledby="services-title">
        <div class="section-heading" data-reveal>
          <p class="section-kicker">01 / Servicios</p>
          <h2 id="services-title">El control que tu operación necesita, en un solo equipo.</h2>
          <p>Selecciona una capa o combinémoslas según el tipo de carga, la ruta y el nivel de exposición.</p>
        </div>

        <div class="service-board">
          {services.map((service, index) => (
            <article class="service-card" data-reveal style={`--reveal-delay: ${index * 55}ms`}>
              <div class="service-card-top"><span>{service.number}</span><span>Servicio KGB</span></div>
              <h3>{service.name}</h3>
              <p>{service.detail}</p>
              <ul>
                {service.items.map((item) => <li>{item}</li>)}
              </ul>
              <a href="#contact" aria-label={`Solicitar información sobre ${service.name}`}>Consultar este servicio <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="operation-section" id="operation" aria-labelledby="operation-title">
        <div class="operation-intro" data-reveal>
          <p class="section-kicker">02 / Operación</p>
          <h2 id="operation-title">La seguridad se organiza antes de que la carga se mueva.</h2>
          <p>Convertimos el recorrido en decisiones concretas: qué observar, dónde intervenir y cuándo escalar.</p>
          <a class="quiet-link quiet-link-light" href="#contact">Hablar sobre una ruta <span aria-hidden="true">↗</span></a>
        </div>

        <ol class="operation-list">
          {operationSteps.map((step, index) => (
            <li class="operation-step" data-reveal style={`--reveal-delay: ${index * 65}ms`}>
              <span class="step-number">{step.number}</span>
              <div>
                <h3>{step.name}</h3>
                <p>{step.detail}</p>
              </div>
              <span class="step-marker" aria-hidden="true"></span>
            </li>
          ))}
        </ol>
      </section>

      <section class="section-block coverage-section" id="coverage" aria-labelledby="coverage-title">
        <div class="coverage-panel" data-reveal>
          <div class="coverage-panel-header"><span>Alcance de la operación</span><span>Nacional</span></div>
          <div class="coverage-route" aria-hidden="true">
            <span class="route-node"><i></i><b>Puerto</b></span>
            <span class="route-segment"></span>
            <span class="route-node route-node-active"><i></i><b>Tránsito</b></span>
            <span class="route-segment"></span>
            <span class="route-node"><i></i><b>Destino</b></span>
          </div>
          <div class="coverage-panel-bottom"><strong>Cobertura nacional</strong><span>Personal, protocolos y monitoreo alrededor de la ruta.</span></div>
        </div>

        <div class="coverage-copy" data-reveal style="--reveal-delay: 90ms">
          <p class="section-kicker">03 / Cobertura</p>
          <h2 id="coverage-title">De todos los puertos a cada punto de control.</h2>
          <p>El alcance cambia en cada operación. La coordinación, la visibilidad y la respuesta deben mantenerse conectadas.</p>
          <div class="coverage-facts">
            <div><strong>Nacional</strong><span>Alcance de servicio</span></div>
            <div><strong>Control</strong><span>Coordinación por etapa</span></div>
            <div><strong>Import–export</strong><span>Especialidad de KGB</span></div>
          </div>
          <a class="button button-outline" href="#contact">Definir el alcance <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <div class="contact-intro" data-reveal>
          <p class="section-kicker">04 / Cotización</p>
          <h2 id="contact-title">Cuéntanos qué necesitas proteger.</h2>
          <p>Con la información de tu operación podemos orientarte hacia la combinación de servicios adecuada.</p>
          <div class="contact-details">
            <a href="tel:+593985511942">098 551 1942</a>
            <a href="tel:+593979956335">097 995 6335</a>
            <a href="mailto:katherineguevara13@hotmail.com">katherineguevara13@hotmail.com</a>
          </div>
        </div>

        <form class="contact-form" id="contact-form" data-reveal style="--reveal-delay: 90ms">
          <div class="form-heading"><span>Solicitud de servicio</span><span>01 / 04</span></div>
          <div class="form-field">
            <label for="name">Tu nombre</label>
            <input id="name" name="name" type="text" autocomplete="name" placeholder="¿Con quién tenemos el gusto?" required />
          </div>
          <div class="form-field">
            <label for="company">Empresa</label>
            <input id="company" name="company" type="text" autocomplete="organization" placeholder="Nombre de tu empresa" required />
          </div>
          <div class="form-field form-field-wide">
            <label for="service">¿Qué necesitas proteger?</label>
            <select id="service" name="service" required>
              <option value="" disabled selected>Selecciona un servicio</option>
              {serviceOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </div>
          <div class="form-field form-field-wide">
            <label for="message">Detalles de la operación</label>
            <textarea id="message" name="message" rows="5" placeholder="Ruta, tipo de mercancía, tiempos o cualquier detalle útil." required></textarea>
          </div>
          <div class="form-submit">
            <button class="button button-primary" type="submit">Enviar solicitud <span aria-hidden="true">↗</span></button>
            <p class="form-status" id="form-status" aria-live="polite"></p>
          </div>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <a class="brand-lockup brand-lockup-footer" href="#top" aria-label="KGB Security Services & Solutions, inicio">
          <img src="/assets/kgb-logo-official.png" alt="KGB Security Services & Solutions" width="280" height="90" />
        </a>
        <p>Seguridad integral para importación y exportación.</p>
      </div>
      <div class="footer-links">
        <a href="https://www.instagram.com/kgbsecurityservices" target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a>
        <a href="#contact">Solicitar evaluación <span aria-hidden="true">↗</span></a>
      </div>
      <p class="footer-legal">© {new Date().getFullYear()} KGB Security Services & Solutions</p>
    </footer>
  </div>
</BaseLayout>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = document.querySelector<HTMLElement>(".main-navigation");

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    navigation?.classList.toggle("is-open", !isOpen);
  });

  navigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menuToggle?.setAttribute("aria-expanded", "false");
      navigation.classList.remove("is-open");
    });
  });

  const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if ("IntersectionObserver" in window) {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: "0px 0px -30px 0px" },
    );

    revealItems.forEach((item) => revealObserver.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  }

  const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
  const formStatus = document.querySelector<HTMLElement>("#form-status");

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    formStatus && (formStatus.textContent = "Gracias. Revisaremos los detalles de tu operación.");
    contactForm.reset();
  });
</script>
