---
import BaseLayout from "../layouts/BaseLayout.astro";

const navigation = [
  { href: "#services", label: "Servicios" },
  { href: "#operation", label: "Operación" },
  { href: "#coverage", label: "Cobertura" },
];

const services = [
  {
    number: "01",
    name: "Seguridad física",
    summary: "Personal preparado para proteger accesos, instalaciones y puntos críticos.",
    scope: "Control de accesos · rondas de vigilancia · prevención y respuesta",
  },
  {
    number: "02",
    name: "Seguridad electrónica",
    summary: "Tecnología para mantener la operación visible cuando más importa.",
    scope: "Cámaras · alarmas · sensores · monitoreo especializado",
  },
  {
    number: "03",
    name: "Custodias para importación y exportación",
    summary: "Acompañamiento coordinado para mercancías en tránsito y almacenamiento.",
    scope: "Custodias armadas · custodias fluviales · acompañamiento de ruta",
  },
  {
    number: "04",
    name: "Inspecciones especializadas",
    summary: "Verificaciones adicionales para operaciones que requieren mayor control.",
    scope: "Inspecciones K9 · sustancias sujetas a fiscalización · pruebas poligráficas",
  },
];

const operationSteps = [
  { number: "01", name: "Origen", detail: "Entendemos la carga, el punto de salida y sus condiciones." },
  { number: "02", name: "Control", detail: "Definimos qué observar, quién interviene y con qué protocolo." },
  { number: "03", name: "Tránsito", detail: "Acompañamos la ruta con personal, tecnología y comunicación." },
  { number: "04", name: "Destino", detail: "Verificamos el cierre de la operación y sus puntos sensibles." },
];

const serviceOptions = [
  "Seguridad física",
  "Seguridad electrónica",
  "Custodia de mercancía",
  "Inspección especializada",
  "Necesito orientación",
];
---

<BaseLayout
  title="KGB Security Services & Solutions"
  description="Seguridad física, electrónica y custodia para operaciones de importación y exportación."
>
  <div class="site-shell" id="top">
    <header class="site-header">
      <a class="brand" href="#top" aria-label="KGB Security Services & Solutions, inicio">
        <img src="/assets/kgb-logo-official.png" alt="KGB Security Services & Solutions" width="340" height="110" />
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">
        <span>Menú</span>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      </button>

      <nav class="main-navigation" id="main-navigation" aria-label="Navegación principal">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="header-cta" href="#contact">Solicitar cotización <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <div class="brand-line" aria-label="Especialidad de KGB">
      <div class="brand-line-inner">
        <span>Seguridad integral para mercancías de importación y exportación</span>
        <span>Alcance nacional</span>
      </div>
    </div>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow"><span aria-hidden="true">01</span> Seguridad logística</p>
          <h1 id="hero-title">Protección que sigue tu ruta.</h1>
          <p class="hero-intro">
            Integramos seguridad física, tecnología y custodias para que tu operación avance con claridad desde el origen hasta el destino.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#contact">Solicitar una cotización <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#services">Ver nuestros servicios <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-facts" aria-label="Alcances de KGB">
            <div><span>Alcance</span><strong>Nacional</strong></div>
            <div><span>Especialidad</span><strong>Importación y exportación</strong></div>
            <div><span>Respuesta</span><strong>Coordinada</strong></div>
          </div>
        </div>

        <figure class="hero-visual" data-reveal style="--reveal-delay: 90ms">
          <div class="hero-image-wrap">
            <img src="/assets/cargo-reference.png" alt="Contenedores y vehículo de seguridad en una operación portuaria" width="525" height="655" />
            <div class="hero-image-tag"><span>KGB / 01</span><strong>La carga no se detiene.</strong></div>
          </div>
          <figcaption><span>Cadena logística</span><strong>Origen <i aria-hidden="true">→</i> tránsito <i aria-hidden="true">→</i> destino</strong></figcaption>
        </figure>
      </section>

      <section class="services-section" id="services" aria-labelledby="services-title">
        <div class="section-heading" data-reveal>
          <p class="section-number">02</p>
          <div>
            <p class="eyebrow">Servicios</p>
            <h2 id="services-title">Una respuesta completa para cada punto de control.</h2>
          </div>
          <p class="section-description">Elige una capa o combinémoslas según tu mercancía, tu ruta y el alcance de la operación.</p>
        </div>

        <div class="service-list">
          {services.map((service, index) => (
            <article class="service-row" data-reveal style={`--reveal-delay: ${index * 55}ms`}>
              <span class="service-number">{service.number}</span>
              <h3>{service.name}</h3>
              <div class="service-copy"><p>{service.summary}</p><span>{service.scope}</span></div>
              <a href="#contact" aria-label={`Solicitar información sobre ${service.name}`}>Consultar <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="operation-section" id="operation" aria-labelledby="operation-title">
        <div class="section-heading section-heading-dark" data-reveal>
          <p class="section-number">03</p>
          <div>
            <p class="eyebrow">Operación</p>
            <h2 id="operation-title">La seguridad se organiza antes de que la carga se mueva.</h2>
          </div>
          <p class="section-description">Convertimos el recorrido en decisiones concretas: qué observar, dónde intervenir y cuándo escalar.</p>
        </div>

        <ol class="route-list">
          {operationSteps.map((step, index) => (
            <li class="route-step" data-reveal style={`--reveal-delay: ${index * 65}ms`}>
              <span class="route-node"><i aria-hidden="true"></i>{step.number}</span>
              <div><h3>{step.name}</h3><p>{step.detail}</p></div>
            </li>
          ))}
        </ol>
      </section>

      <section class="coverage-section" id="coverage" aria-labelledby="coverage-title">
        <div class="coverage-copy" data-reveal>
          <p class="section-number">04</p>
          <p class="eyebrow">Cobertura</p>
          <h2 id="coverage-title">De todos los puertos a cada punto de control.</h2>
          <p>El alcance cambia en cada operación. La coordinación, la visibilidad y la respuesta deben mantenerse conectadas.</p>
          <a class="text-link" href="#contact">Definir el alcance de tu operación <span aria-hidden="true">↗</span></a>
        </div>

        <div class="coverage-visual" data-reveal style="--reveal-delay: 90ms">
          <div class="coverage-visual-top"><span>Ruta de protección</span><span>Nacional</span></div>
          <figure class="coverage-route">
            <img src="/assets/route-protection.png" alt="Ruta protegida desde el puerto, durante el tránsito y hasta el destino" width="1200" height="360" />
            <figcaption class="coverage-labels"><span>Puerto</span><span>Tránsito</span><span>Destino</span></figcaption>
          </figure>
          <div class="coverage-visual-bottom"><strong>Una misma lectura de seguridad para toda la ruta.</strong><span>Personal · tecnología · protocolos</span></div>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <div class="contact-copy" data-reveal>
          <p class="section-number">05</p>
          <p class="eyebrow">Cotización</p>
          <h2 id="contact-title">Cuéntanos qué necesitas proteger.</h2>
          <p>Con la información de tu operación podemos orientarte hacia la combinación de servicios adecuada.</p>
          <div class="contact-details">
            <a href="tel:+593985511942">098 551 1942</a>
            <a href="tel:+593979956335">097 995 6335</a>
            <a href="mailto:katherineguevara13@hotmail.com">katherineguevara13@hotmail.com</a>
          </div>
        </div>

        <form class="contact-form" id="contact-form" data-reveal style="--reveal-delay: 90ms">
          <div class="form-heading"><span>Solicitud de servicio</span><span>Información de contacto</span></div>
          <div class="form-field">
            <label for="name">Tu nombre</label>
            <input id="name" name="name" type="text" autocomplete="name" placeholder="¿Con quién tenemos el gusto?" required />
          </div>
          <div class="form-field">
            <label for="company">Empresa</label>
            <input id="company" name="company" type="text" autocomplete="organization" placeholder="Nombre de tu empresa" required />
          </div>
          <div class="form-field form-field-wide">
            <label for="service">¿Qué necesitas proteger?</label>
            <select id="service" name="service" required>
              <option value="" disabled selected>Selecciona un servicio</option>
              {serviceOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </div>
          <div class="form-field form-field-wide">
            <label for="message">Detalles de la operación</label>
            <textarea id="message" name="message" rows="5" placeholder="Ruta, tipo de mercancía, tiempos o cualquier detalle útil." required></textarea>
          </div>
          <div class="form-submit">
            <button class="button button-primary" type="submit">Enviar solicitud <span aria-hidden="true">↗</span></button>
            <p class="form-status" id="form-status" aria-live="polite"></p>
          </div>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand brand-footer" href="#top" aria-label="KGB Security Services & Solutions, inicio">
        <img src="/assets/kgb-logo-official.png" alt="KGB Security Services & Solutions" width="300" height="97" />
      </a>
      <div class="footer-links">
        <a href="https://www.instagram.com/kgbsecurityservices" target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a>
        <a href="#contact">Solicitar cotización <span aria-hidden="true">↗</span></a>
      </div>
      <p class="footer-legal">Seguridad integral para importación y exportación · © {new Date().getFullYear()} KGB Security Services & Solutions</p>
    </footer>
  </div>
</BaseLayout>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = document.querySelector<HTMLElement>(".main-navigation");

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    navigation?.classList.toggle("is-open", !isOpen);
  });

  navigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menuToggle?.setAttribute("aria-expanded", "false");
      navigation.classList.remove("is-open");
    });
  });

  const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if ("IntersectionObserver" in window) {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: "0px 0px -30px 0px" },
    );

    revealItems.forEach((item) => revealObserver.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  }

  const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
  const formStatus = document.querySelector<HTMLElement>("#form-status");

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    formStatus && (formStatus.textContent = "Gracias. Revisaremos los detalles de tu operación.");
    contactForm.reset();
  });
</script>
