---
import BaseLayout from "../layouts/BaseLayout.astro";

const navigation = [
  { href: "#services", label: "Servicios" },
  { href: "#process", label: "Cómo trabajamos" },
  { href: "#coverage", label: "Cobertura" },
];

const services = [
  {
    number: "01",
    name: "Seguridad física",
    summary:
      "Personal preparado para cuidar accesos, instalaciones y puntos críticos de la operación.",
    details: "Control de accesos, rondas de vigilancia y prevención ante incidentes.",
  },
  {
    number: "02",
    name: "Seguridad electrónica",
    summary:
      "Tecnología que mantiene la operación visible cuando más importa.",
    details: "Cámaras, alarmas, sensores, candados satelitales y monitoreo especializado.",
  },
  {
    number: "03",
    name: "Custodias para importación y exportación",
    summary:
      "Acompañamiento coordinado para que la mercancía avance con protocolos claros.",
    details: "Custodias armadas, fluviales y acompañamiento según la ruta y el alcance requerido.",
  },
  {
    number: "04",
    name: "Inspecciones especializadas",
    summary:
      "Capas adicionales de verificación para operaciones que exigen mayor control.",
    details: "Inspecciones K9 de sustancias sujetas a fiscalización y pruebas poligráficas.",
  },
];

const process = [
  {
    number: "01",
    name: "Presencia",
    detail: "Seguridad física para las personas, instalaciones y accesos que sostienen la operación.",
  },
  {
    number: "02",
    name: "Visibilidad",
    detail: "Cámaras, monitoreo y candados satelitales para leer lo que ocurre mientras la carga avanza.",
  },
  {
    number: "03",
    name: "Tránsito",
    detail: "Custodias y acompañamiento para operaciones de importación y exportación.",
  },
  {
    number: "04",
    name: "Verificación",
    detail: "Inspecciones K9 y pruebas especializadas como capas adicionales de control.",
  },
];

const serviceOptions = [
  "Seguridad física",
  "Seguridad electrónica",
  "Custodia de mercancía",
  "Inspección especializada",
  "Necesito orientación",
];
---

<BaseLayout
  title="KGB Security Services & Solutions"
  description="Seguridad física, electrónica y custodia para operaciones de importación y exportación."
>
  <div class="site-shell" id="top">
    <header class="site-header">
      <a class="brand" href="#top" aria-label="KGB Security Services & Solutions, inicio">
        <img src="/assets/kgb-logo-extracted-prototype.png" alt="KGB Security Services & Solutions" width="300" height="104" />
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">
        <span>Menú</span>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      </button>

      <nav class="main-navigation" id="main-navigation" aria-label="Navegación principal">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="nav-cta" href="#contact">Hablemos</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow">Seguridad para operaciones en movimiento</p>
          <h1 id="hero-title">Tu carga sigue su ruta. <em>Nosotros cuidamos el proceso.</em></h1>
          <p class="hero-lede">
            Acompañamos operaciones de importación y exportación con seguridad física, tecnología de monitoreo y custodias coordinadas.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#contact">Cuéntanos tu operación <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#services">Conoce nuestros servicios <span aria-hidden="true">↓</span></a>
          </div>
          <dl class="hero-facts" aria-label="Alcances de KGB">
            <div>
              <dt>Alcance</dt>
              <dd>Nacional</dd>
            </div>
            <div>
              <dt>Disponibilidad</dt>
              <dd>24/7</dd>
            </div>
            <div>
              <dt>Especialidad</dt>
              <dd>Import–export</dd>
            </div>
          </dl>
        </div>

        <figure class="hero-visual" data-reveal style="--reveal-delay: 90ms">
          <div class="hero-image-wrap">
            <img src="/assets/cargo-reference.png" alt="Contenedores y vehículo de seguridad junto a una operación portuaria" width="1200" height="900" />
            <span class="image-note">Protección para una operación en movimiento.</span>
          </div>
          <figcaption>
            <span>01</span>
            <span>De origen a destino, cada etapa merece una mirada clara.</span>
          </figcaption>
        </figure>
      </section>

      <div class="section-rule" aria-hidden="true"><span>Seguridad integral</span><span>Desde el primer control hasta la entrega</span></div>

      <section class="content-section services-section" id="services" aria-labelledby="services-title">
        <div class="section-intro" data-reveal>
          <p class="section-marker">01 · Servicios</p>
          <h2 id="services-title">Una respuesta completa para lo que no puede detenerse.</h2>
          <p>
            Diseñamos el acompañamiento alrededor de tu operación: sus accesos, su ruta, su mercancía y el nivel de control que necesita.
          </p>
          <a class="text-link" href="#contact">Conversemos sobre tu alcance <span aria-hidden="true">↗</span></a>
        </div>

        <div class="service-list">
          {services.map((service, index) => (
            <article class="service-item" data-reveal style={`--reveal-delay: ${index * 55}ms`}>
              <div class="service-meta"><span>{service.number}</span><span>Servicio KGB</span></div>
              <div class="service-content">
                <h3>{service.name}</h3>
                <p>{service.summary}</p>
                <p class="service-detail">{service.details}</p>
              </div>
              <span class="service-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section class="process-section" id="process" aria-labelledby="process-title">
        <div class="process-heading" data-reveal>
          <p class="section-marker">02 · El proceso</p>
          <h2 id="process-title">Cuatro capas alrededor de la operación.</h2>
          <p>La seguridad se vuelve más útil cuando cada decisión tiene un lugar dentro de la ruta.</p>
        </div>

        <div class="process-list">
          {process.map((step, index) => (
            <div class="process-row" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
              <span class="process-number">{step.number}</span>
              <h3>{step.name}</h3>
              <p>{step.detail}</p>
              <span class="process-line" aria-hidden="true"></span>
            </div>
          ))}
        </div>
      </section>

      <section class="coverage-section" id="coverage" aria-labelledby="coverage-title">
        <div class="coverage-visual" data-reveal aria-hidden="true">
          <div class="route-label route-label-start">Origen</div>
          <div class="route-label route-label-middle">Tránsito</div>
          <div class="route-label route-label-end">Destino</div>
          <div class="route-line"><span class="route-dot"></span><span class="route-dot"></span><span class="route-dot"></span></div>
          <div class="coverage-word">Nacional</div>
        </div>
        <div class="coverage-copy" data-reveal style="--reveal-delay: 90ms">
          <p class="section-marker">03 · Cobertura</p>
          <h2 id="coverage-title">La ruta cambia. El cuidado permanece.</h2>
          <p>
            Trabajamos con alcance nacional para acompañar los puntos que hacen posible tu operación de importación o exportación.
          </p>
          <p class="coverage-note">Cuéntanos desde dónde sale tu carga, hacia dónde va y qué necesitas proteger.</p>
          <a class="button button-dark" href="#contact">Planificar una conversación <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <div class="contact-heading" data-reveal>
          <p class="section-marker">04 · Contacto</p>
          <h2 id="contact-title">Hablemos de tu operación.</h2>
          <p>Cuéntanos qué estás moviendo y qué parte del proceso quieres hacer más segura.</p>
          <div class="contact-details">
            <a href="tel:+593985511942">098 551 1942</a>
            <a href="tel:+593979956335">097 995 6335</a>
            <a href="mailto:katherineguevara13@hotmail.com">katherineguevara13@hotmail.com</a>
          </div>
        </div>

        <form class="contact-form" id="contact-form" data-reveal style="--reveal-delay: 90ms">
          <div class="form-field">
            <label for="name">Tu nombre</label>
            <input id="name" name="name" type="text" autocomplete="name" placeholder="¿Con quién tenemos el gusto?" required />
          </div>
          <div class="form-field">
            <label for="company">Empresa</label>
            <input id="company" name="company" type="text" autocomplete="organization" placeholder="Nombre de tu empresa" required />
          </div>
          <div class="form-field form-field-wide">
            <label for="service">¿Qué necesitas proteger?</label>
            <select id="service" name="service" required>
              <option value="" disabled selected>Selecciona un servicio</option>
              {serviceOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </div>
          <div class="form-field form-field-wide">
            <label for="message">Cuéntanos un poco más</label>
            <textarea id="message" name="message" rows="5" placeholder="Ruta, tipo de mercancía, tiempos o cualquier detalle útil." required></textarea>
          </div>
          <div class="form-submit">
            <button class="button button-primary" type="submit">Enviar solicitud <span aria-hidden="true">↗</span></button>
            <p class="form-status" id="form-status" aria-live="polite"></p>
          </div>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <img src="/assets/kgb-logo-extracted-prototype.png" alt="KGB Security Services & Solutions" width="220" height="76" />
        <p>Seguridad integral para importación y exportación.</p>
      </div>
      <div class="footer-social">
        <a href="https://www.instagram.com/kgbsecurityservices" target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a>
        <a href="#top">Volver arriba <span aria-hidden="true">↑</span></a>
      </div>
      <p class="footer-legal">© {new Date().getFullYear()} KGB Security Services & Solutions</p>
    </footer>
  </div>
</BaseLayout>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = document.querySelector<HTMLElement>(".main-navigation");

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    navigation?.classList.toggle("is-open", !isOpen);
  });

  navigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menuToggle?.setAttribute("aria-expanded", "false");
      navigation.classList.remove("is-open");
    });
  });

  const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if ("IntersectionObserver" in window) {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: "0px 0px -30px 0px" },
    );

    revealItems.forEach((item) => revealObserver.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  }

  const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
  const formStatus = document.querySelector<HTMLElement>("#form-status");

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    formStatus && (formStatus.textContent = "Gracias. Revisaremos los detalles de tu operación.");
    contactForm.reset();
  });
</script>
