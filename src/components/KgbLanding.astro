---
import BaseLayout from "../layouts/BaseLayout.astro";

const navigation = [
  { href: "#services", label: "Servicios" },
  { href: "#operation", label: "Cómo trabajamos" },
  { href: "#coverage", label: "Cobertura" },
];

const serviceGroups = [
  {
    number: "01",
    title: "Protección en sitio",
    name: "Seguridad física",
    summary: "Personal preparado para controlar accesos, vigilar instalaciones y responder ante incidentes.",
    scope: "Control de accesos · rondas · prevención",
  },
  {
    number: "02",
    title: "Visibilidad y control",
    name: "Seguridad electrónica",
    summary: "Cámaras, alarmas y monitoreo para mantener los puntos críticos bajo observación.",
    scope: "Cámaras · sensores · monitoreo",
  },
  {
    number: "03",
    title: "Movimiento de mercancías",
    name: "Custodias para importación y exportación",
    summary: "Acompañamiento coordinado para proteger la carga durante el tránsito y el almacenamiento.",
    scope: "Custodias armadas · fluviales · rutas",
  },
  {
    number: "04",
    title: "Inspección especializada",
    name: "Servicios complementarios",
    summary: "Controles adicionales para operaciones que requieren una revisión más precisa.",
    scope: "K9 · sustancias fiscalizadas · poligrafía",
  },
];

const operationSteps = [
  { phase: "Antes", title: "Evaluamos", detail: "Entendemos la mercancía, la ruta y los puntos que requieren atención." },
  { phase: "Antes", title: "Preparamos", detail: "Definimos personal, tecnología y protocolos según el alcance acordado." },
  { phase: "Durante", title: "Acompañamos", detail: "Mantenemos la operación coordinada mientras la carga se mueve." },
  { phase: "Después", title: "Cerramos", detail: "Registramos el resultado y dejamos claros los siguientes pasos." },
];

const serviceOptions = [
  "Seguridad física",
  "Seguridad electrónica",
  "Custodia de mercancía",
  "Inspección especializada",
  "Necesito orientación",
];
---

<BaseLayout
  title="KGB Security Services & Solutions"
  description="Seguridad física, electrónica y custodia para operaciones de importación y exportación."
>
  <div class="site-shell" id="top">
    <header class="site-header">
      <a class="brand" href="#top" aria-label="KGB Security Services & Solutions, inicio">
        <img src="/assets/kgb-logo-official.png" alt="KGB Security Services & Solutions" width="340" height="110" />
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">
        <span>Menú</span>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      </button>

      <nav class="main-navigation" id="main-navigation" aria-label="Navegación principal">
        <div class="main-navigation-links">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
        <div class="header-actions">
          <a class="header-phone" href="tel:+593985511942">098 551 1942</a>
          <a class="header-cta" href="#contact">Solicitar cotización <span aria-hidden="true">↗</span></a>
        </div>
      </nav>
    </header>

    <div class="top-note" aria-label="Especialidad de KGB">
      <div class="top-note-inner">
        <span>Seguridad para importación y exportación</span>
        <span>Del origen al destino</span>
      </div>
    </div>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy" data-reveal>
          <p class="kicker">Seguridad logística</p>
          <h1 id="hero-title">Seguridad para tu carga, de origen a destino.</h1>
          <p class="hero-intro">
            Coordinamos seguridad física, tecnología y custodias según el recorrido de tu mercancía para que la operación avance con claridad.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#contact">Solicitar una evaluación <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#services">Conocer los servicios <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-proof" aria-label="Capas de protección">
            <div>
              <span class="proof-mark" aria-hidden="true">—</span>
              <div><strong>Personal</strong><small>presencia donde importa</small></div>
            </div>
            <div>
              <span class="proof-mark" aria-hidden="true">—</span>
              <div><strong>Tecnología</strong><small>visibilidad y control</small></div>
            </div>
            <div>
              <span class="proof-mark" aria-hidden="true">—</span>
              <div><strong>Protocolos</strong><small>respuesta coordinada</small></div>
            </div>
          </div>
        </div>

        <figure class="hero-visual" data-reveal style="--reveal-delay: 90ms">
          <div class="hero-image-frame">
            <img src="/assets/cargo-reference.png" alt="Contenedores y vehículo de seguridad en una operación portuaria" width="525" height="655" loading="eager" />
            <div class="hero-image-note">
              <span>Cadena logística</span>
              <strong>Protección visible en cada tramo.</strong>
            </div>
          </div>
          <figcaption>Seguridad física · tecnología · custodia</figcaption>
        </figure>
      </section>

      <section class="services-section" id="services" aria-labelledby="services-title">
        <div class="section-intro" data-reveal>
          <div>
            <p class="kicker">Servicios</p>
            <h2 id="services-title">Una estrategia de protección para cada necesidad.</h2>
          </div>
          <p class="section-lede">Organizamos las soluciones por el problema que deben resolver, no como una lista aislada de servicios.</p>
        </div>

        <div class="service-list">
          {serviceGroups.map((service, index) => (
            <article class="service-row" data-reveal style={`--reveal-delay: ${index * 55}ms`}>
              <span class="service-number">{service.number}</span>
              <div class="service-title">
                <span>{service.title}</span>
                <h3>{service.name}</h3>
              </div>
              <div class="service-copy">
                <p>{service.summary}</p>
                <span>{service.scope}</span>
              </div>
              <a href="#contact" aria-label={`Solicitar información sobre ${service.name}`}>Consultar <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="operation-section" id="operation" aria-labelledby="operation-title">
        <div class="operation-heading" data-reveal>
          <div>
            <p class="kicker kicker-light">Cómo trabajamos</p>
            <h2 id="operation-title">La seguridad se prepara antes de que la carga se mueva.</h2>
          </div>
          <p>Convertimos el recorrido en decisiones concretas: qué observar, dónde intervenir y cómo mantener la operación coordinada.</p>
        </div>

        <ol class="process-list">
          {operationSteps.map((step, index) => (
            <li class="process-step" data-reveal style={`--reveal-delay: ${index * 65}ms`}>
              <div class="process-marker"><span>{String(index + 1).padStart(2, "0")}</span><i aria-hidden="true"></i></div>
              <span class="process-phase">{step.phase}</span>
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="coverage-section" id="coverage" aria-labelledby="coverage-title">
        <div class="coverage-copy" data-reveal>
          <p class="kicker">Cobertura</p>
          <h2 id="coverage-title">Una misma lectura de seguridad para toda la ruta.</h2>
          <p>El alcance cambia en cada operación. La coordinación y la respuesta deben mantenerse conectadas desde el puerto hasta el destino.</p>
          <a class="text-link" href="#contact">Definir el alcance de tu operación <span aria-hidden="true">↗</span></a>
        </div>

        <div class="route-board" data-reveal style="--reveal-delay: 90ms" aria-label="Etapas de una ruta protegida">
          <div class="route-board-head"><span>Ruta de protección</span><span>Origen → destino</span></div>
          <div class="route-track">
            <div class="route-track-line" aria-hidden="true"></div>
            <div class="route-point">
              <span class="route-point-node">01</span>
              <strong>Puerto</strong>
              <small>Recepción y control inicial</small>
            </div>
            <div class="route-point route-point-active">
              <span class="route-point-node">02</span>
              <strong>Tránsito</strong>
              <small>Acompañamiento y monitoreo</small>
            </div>
            <div class="route-point">
              <span class="route-point-node">03</span>
              <strong>Destino</strong>
              <small>Cierre de la operación</small>
            </div>
          </div>
          <div class="route-board-foot"><strong>Personal · tecnología · protocolos</strong><span>El esquema se define según la operación.</span></div>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <div class="contact-copy" data-reveal>
          <p class="kicker">Cotización</p>
          <h2 id="contact-title">Hablemos de tu operación.</h2>
          <p>Cuéntanos qué necesitas proteger y te orientaremos hacia la combinación de servicios adecuada.</p>
          <div class="contact-details">
            <a href="tel:+593985511942">098 551 1942</a>
            <a href="tel:+593979956335">097 995 6335</a>
            <a href="mailto:katherineguevara13@hotmail.com">katherineguevara13@hotmail.com</a>
          </div>
        </div>

        <form class="contact-form" id="contact-form" data-reveal style="--reveal-delay: 90ms">
          <div class="form-heading"><strong>Solicitar una evaluación</strong><span>Te responderemos con los siguientes pasos.</span></div>
          <div class="form-field">
            <label for="name">Nombre de contacto</label>
            <input id="name" name="name" type="text" autocomplete="name" placeholder="Tu nombre" required />
          </div>
          <div class="form-field">
            <label for="company">Empresa</label>
            <input id="company" name="company" type="text" autocomplete="organization" placeholder="Nombre de tu empresa" required />
          </div>
          <div class="form-field form-field-wide">
            <label for="service">Servicio que necesitas</label>
            <select id="service" name="service" required>
              <option value="" disabled selected>Selecciona una opción</option>
              {serviceOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </div>
          <div class="form-field form-field-wide">
            <label for="message">Contexto de la operación</label>
            <textarea id="message" name="message" rows="5" placeholder="Ruta, tipo de mercancía, tiempos o cualquier detalle útil." required></textarea>
          </div>
          <div class="form-submit">
            <button class="button button-primary" type="submit">Enviar solicitud <span aria-hidden="true">↗</span></button>
            <p class="form-status" id="form-status" aria-live="polite"></p>
          </div>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand brand-footer" href="#top" aria-label="KGB Security Services & Solutions, inicio">
        <img src="/assets/kgb-logo-official.png" alt="KGB Security Services & Solutions" width="300" height="97" />
      </a>
      <div class="footer-links">
        <a href="https://www.instagram.com/kgbsecurityservices" target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a>
        <a href="#contact">Solicitar cotización <span aria-hidden="true">↗</span></a>
      </div>
      <p class="footer-legal">Seguridad integral para importación y exportación · © {new Date().getFullYear()} KGB Security Services & Solutions</p>
    </footer>
  </div>
</BaseLayout>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = document.querySelector<HTMLElement>(".main-navigation");

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    navigation?.classList.toggle("is-open", !isOpen);
  });

  navigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menuToggle?.setAttribute("aria-expanded", "false");
      navigation.classList.remove("is-open");
    });
  });

  const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if ("IntersectionObserver" in window) {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: "0px 0px -30px 0px" },
    );

    revealItems.forEach((item) => revealObserver.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  }

  const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
  const formStatus = document.querySelector<HTMLElement>("#form-status");

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    formStatus && (formStatus.textContent = "Gracias. Revisaremos los detalles de tu operación.");
    contactForm.reset();
  });
</script>
